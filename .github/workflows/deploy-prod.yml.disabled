name: Deploy to prod

on:
  push:
    branches: [main]

jobs:
  deploy:
    name: Deploy to Kubernetes prod
    runs-on: ubuntu-latest
    environment: prod  # requires manual approval in GitHub

    permissions:
      contents: read
      packages: write

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Log in to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push production images
        run: |
          # Semantic layer — HF_TOKEN removed, model loaded at runtime from PVC
          docker build \
            -t ghcr.io/cdjepeno/ecom-semantic-layer:${{ github.sha }} \
            -t ghcr.io/cdjepeno/ecom-semantic-layer:prod \
            ./src/semantic_layer
          docker push ghcr.io/cdjepeno/ecom-semantic-layer:${{ github.sha }}
          docker push ghcr.io/cdjepeno/ecom-semantic-layer:prod

          # FastAPI
          docker build \
            -t ghcr.io/cdjepeno/ecom-fastapi:${{ github.sha }} \
            -t ghcr.io/cdjepeno/ecom-fastapi:prod \
            ./src/fast_api
          docker push ghcr.io/cdjepeno/ecom-fastapi:${{ github.sha }}
          docker push ghcr.io/cdjepeno/ecom-fastapi:prod

          # Pipeline
          docker build \
            -t ghcr.io/cdjepeno/ecom-pipeline:${{ github.sha }} \
            -t ghcr.io/cdjepeno/ecom-pipeline:prod \
            ./src/etl_ecom
          docker push ghcr.io/cdjepeno/ecom-pipeline:${{ github.sha }}
          docker push ghcr.io/cdjepeno/ecom-pipeline:prod

          # MCP
          docker build \
            -t ghcr.io/cdjepeno/ecom-mcp:${{ github.sha }} \
            -t ghcr.io/cdjepeno/ecom-mcp:prod \
            ./src/mcp
          docker push ghcr.io/cdjepeno/ecom-mcp:${{ github.sha }}
          docker push ghcr.io/cdjepeno/ecom-mcp:prod

      - name: Set up kubectl
        uses: azure/setup-kubectl@v3
        with:
          version: "v1.31.0"

      - name: Configure kubeconfig
        run: |
          mkdir -p ~/.kube
          echo "${{ secrets.KUBECONFIG_PROD }}" | base64 -d > ~/.kube/config
          chmod 600 ~/.kube/config

      - name: Verify cluster connection
        run: kubectl get nodes

      - name: Update image tags in overlays
        run: |
          # Update all image tags to the current git SHA for traceability and rollback
          sed -i "s|ghcr.io/cdjepeno/ecom-semantic-layer:.*|ghcr.io/cdjepeno/ecom-semantic-layer:${{ github.sha }}|g" \
            infrastructure/kubernetes/overlays/prod/kustomization.yml

          sed -i "s|ghcr.io/cdjepeno/ecom-fastapi:.*|ghcr.io/cdjepeno/ecom-fastapi:${{ github.sha }}|g" \
            infrastructure/kubernetes/overlays/prod/kustomization.yml

          sed -i "s|ghcr.io/cdjepeno/ecom-pipeline:.*|ghcr.io/cdjepeno/ecom-pipeline:${{ github.sha }}|g" \
            infrastructure/kubernetes/overlays/prod/kustomization.yml

          sed -i "s|ghcr.io/cdjepeno/ecom-mcp:.*|ghcr.io/cdjepeno/ecom-mcp:${{ github.sha }}|g" \
            infrastructure/kubernetes/overlays/prod/kustomization.yml

      - name: Deploy to Kubernetes prod
        run: |
          kubectl apply -k infrastructure/kubernetes/overlays/prod/

      - name: Verify deployment
        run: |
          kubectl rollout status deployment/fastapi -n ecom-prod --timeout=180s
          kubectl rollout status deployment/semantic-layer -n ecom-prod --timeout=180s
          kubectl rollout status deployment/mcp -n ecom-prod --timeout=180s
          kubectl rollout status statefulset/nessie -n ecom-prod --timeout=180s
          kubectl get pods -n ecom-prod

      - name: Notify Slack on success
        if: success()
        uses: slackapi/slack-github-action@v1.26.0
        with:
          payload: |
            {
              "text": "✅ Prod deployment succeeded on *${{ github.repository }}*",
              "blocks": [{"type": "section","text": {"type": "mrkdwn","text": "✅ *Deployed to Kubernetes prod* — `${{ github.sha }}`\n*Author:* ${{ github.actor }}\n*<${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}|View run>*"}}]
            }
        env:
          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
          SLACK_WEBHOOK_TYPE: INCOMING_WEBHOOK

      - name: Notify Slack on failure
        if: failure()
        uses: slackapi/slack-github-action@v1.26.0
        with:
          payload: |
            {
              "text": "❌ Prod deployment failed on *${{ github.repository }}*",
              "blocks": [{"type": "section","text": {"type": "mrkdwn","text": "❌ *Deployment to Kubernetes prod failed* — `${{ github.sha }}`\n*Author:* ${{ github.actor }}\n*<${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}|View logs>*"}}]
            }
        env:
          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
          SLACK_WEBHOOK_TYPE: INCOMING_WEBHOOK