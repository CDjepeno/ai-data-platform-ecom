[sqlfluff]
dialect = duckdb
templater = dbt

max_line_length = 120

[sqlfluff:templater:dbt]
project_dir = .
profiles_dir = /home/djepeno/.dbt

exclude_paths =
    target/,
    dbt_packages/,
    logs/

[sqlfluff:rules]
capitalisation.keywords = upper
capitalisation.identifiers = lower
layout.long_lines = ignore